# .env.example
# ──────────────────────────────────────────────────────────────
# COPY THIS FILE to .env and fill in your real values.
# NEVER commit .env to GitHub — it is in .gitignore.
# ──────────────────────────────────────────────────────────────

# Formspree Form ID (for the contact form)
# 1. Sign up free at https://formspree.io
# 2. Create a new form — copy the ID from the URL (e.g. xpzgwqkr)
# 3. In js/main.js replace YOUR_FORM_ID with this value
FORMSPREE_FORM_ID=your_formspree_id_here

# Your website URL (used in sitemap.xml and robots.txt)
SITE_URL=https://yourusername.github.io/myvlog

# Your GitHub username
GITHUB_USERNAME=yourusername
